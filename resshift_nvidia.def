Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-devel-rockylinux9

%post
    # 1. Install Python 3.9 and core system tools
    dnf -y install \
        python3.9 python3.9-devel python3-pip \
        git \
        libX11 libXext libXrender mesa-libGL glib2 && \
    dnf clean all

    # Set up Python 3.9 as default
    ln -sf /usr/bin/python3.9 /usr/bin/python
    ln -sf /usr/bin/python3.9 /usr/local/bin/python
    python3.9 -m ensurepip
    python3.9 -m pip install --no-cache-dir --upgrade pip setuptools wheel

    # 2. PyTorch with CUDA 12.1
    python3.9 -m pip install --no-cache-dir \
        "torch==2.1.2" "torchvision==0.16.2" \
        --index-url https://download.pytorch.org/whl/cu121

    # 3. xformers (must match torch + CUDA version exactly)
    python3.9 -m pip install --no-cache-dir \
        "xformers==0.0.23.post1" \
        --extra-index-url https://download.pytorch.org/whl/cu121

    # 4. Remaining dependencies
    python3.9 -m pip install --no-cache-dir \
        "numpy==1.26.4" \
        "scipy" \
        "opencv-python-headless" \
        "matplotlib" \
        "timm==0.9.12" \
        "pandas" \
        "pillow" \
        "scikit-learn" \
        "scikit-image" \
        "lpips" \
        "loguru" \
        "omegaconf==2.3.0" \
        "six" \
        "tqdm" \
        "albumentations==1.3.1" \
        "einops" \
        "imageio" \
        "loralib" \
        "facexlib" \
        "lmdb" \
        "tensorboard"

%environment
    export PYTHONUNBUFFERED=1
